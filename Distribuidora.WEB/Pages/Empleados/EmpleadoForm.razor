@using Distribuidora.Shared.DTOs

<EditForm Model="Empleado" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Nombre Completo</label>
            <InputText class="form-control" @bind-Value="Empleado!.NombreCompleto" />
            <ValidationMessage For="@(() => Empleado.NombreCompleto)" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Documento</label>
            <InputText class="form-control" @bind-Value="Empleado.Documento" />
            <ValidationMessage For="@(() => Empleado.Documento)" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Telefono</label>
            <InputText class="form-control" @bind-Value="Empleado.Telefono" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Correo</label>
            <InputText class="form-control" type="email" @bind-Value="Empleado.Correo" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Fecha Ingreso</label>
            <InputDate class="form-control" @bind-Value="Empleado.FechaIngreso" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Estado</label>
            <InputSelect class="form-select" @bind-Value="Empleado.Estado">
                <option value="">-- Seleccione --</option>
                <option value="Activo">Activo</option>
                <option value="Inactivo">Inactivo</option>
            </InputSelect>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Zona</label>
            <InputSelect class="form-select" @bind-Value="Empleado.ZonaId">
                <option value="0">-- Seleccione Zona --</option>
                @if (Zonas != null)
                {
                    @foreach (var z in Zonas)
                    {
                        <option value="@z.Id">@z.NombreZona</option>
                    }
                }
            </InputSelect>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Vehiculo</label>
            <InputSelect class="form-select" @bind-Value="Empleado.VehiculoId">
                <option value="0">-- Seleccione Vehiculo --</option>
                @if (Vehiculos != null)
                {
                    @foreach (var v in Vehiculos)
                    {
                        <option value="@v.Id">@v.Placa - @v.Marca @v.Modelo</option>
                    }
                }
            </InputSelect>
        </div>
    </div>

    <button type="submit" class="btn btn-primary me-2">Guardar</button>
    <a class="btn btn-secondary" href="/Empleados">Cancelar</a>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger mt-3">@Error</div>
    }
</EditForm>

@code {
    [Parameter] public EmpleadoDTO? Empleado { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public List<ZonaDTO>? Zonas { get; set; }
    [Parameter] public List<VehiculoDTO>? Vehiculos { get; set; }
}
