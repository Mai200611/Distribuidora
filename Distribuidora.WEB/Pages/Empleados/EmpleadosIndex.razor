@page "/Empleados"
@using Distribuidora.Shared.DTOs
@using Distribuidora.WEB.Services
@inject IRepository Repository
@inject NavigationManager NavigationManager

<h3>Empleados</h3>

<a class="btn btn-primary mb-3" href="/Empleados/create">
    <i class="bi bi-plus-circle"></i> Nuevo Empleado
</a>

<GenericList MyList="Empleados">
    <Body>
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Documento</th>
                    <th>Telefono</th>
                    <th>Correo</th>
                    <th>Fecha Ingreso</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Empleados!)
                {
                    <tr>
                        <td>@e.NombreCompleto</td>
                        <td>@e.Documento</td>
                        <td>@e.Telefono</td>
                        <td>@e.Correo</td>
                        <td>@e.FechaIngreso.ToShortDateString()</td>
                        <td><span class="badge @(e.Estado == "Activo" ? "bg-success" : "bg-secondary")">@e.Estado</span></td>
                        <td>
                            <a class="btn btn-warning btn-sm me-1" href="/Empleados/edit/@e.Id">Editar</a>
                            <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(e.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger mt-2">@Error</div>
}

@code {
    public List<EmpleadoDTO>? Empleados { get; set; }
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        var response = await Repository.Get<List<EmpleadoDTO>>("api/empleados");
        if (response.Error) { Error = await response.GetErrorMessageAsync(); return; }
        Empleados = response.Response;
    }

    private async Task Eliminar(int id)
    {
        var response = await Repository.Delete($"api/empleados/{id}");
        if (response.Error) { Error = await response.GetErrorMessageAsync(); return; }
        Empleados = Empleados!.Where(e => e.Id != id).ToList();
    }
}
