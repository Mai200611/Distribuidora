@page "/Vehiculos"
@using Distribuidora.Shared.DTOs
@using Distribuidora.WEB.Services
@inject IRepository Repository
@inject NavigationManager NavigationManager

<h3>Vehiculos</h3>

<a class="btn btn-primary mb-3" href="/Vehiculos/create">
    <i class="bi bi-plus-circle"></i> Nuevo Vehiculo
</a>

<GenericList MyList="Vehiculos">
    <Body>
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Tipo</th>
                    <th>Placa</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>Kilometraje</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Vehiculos!)
                {
                    <tr>
                        <td>@v.TipoVehiculo</td>
                        <td>@v.Placa</td>
                        <td>@v.Marca</td>
                        <td>@v.Modelo</td>
                        <td>@v.KilometrajeActual km</td>
                        <td><span class="badge @(v.EstadoVehiculo == "Activo" ? "bg-success" : "bg-secondary")">@v.EstadoVehiculo</span></td>
                        <td>
                            <a class="btn btn-warning btn-sm me-1" href="/Vehiculos/edit/@v.Id">Editar</a>
                            <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(v.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger mt-2">@Error</div>
}

@code {
    public List<VehiculoDTO>? Vehiculos { get; set; }
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        var response = await Repository.Get<List<VehiculoDTO>>("api/vehiculos");
        if (response.Error) { Error = await response.GetErrorMessageAsync(); return; }
        Vehiculos = response.Response;
    }

    private async Task Eliminar(int id)
    {
        var response = await Repository.Delete($"api/vehiculos/{id}");
        if (response.Error) { Error = await response.GetErrorMessageAsync(); return; }
        Vehiculos = Vehiculos!.Where(v => v.Id != id).ToList();
    }
}
